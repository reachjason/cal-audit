# Copy to .env and fill in ONE of the following. .env is gitignored.

# cal.com -> Settings > Developer > API keys  (starts with cal_live_)
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Calendly -> Integrations > API & Webhooks > Personal Access Token
CALENDLY_TOKEN=eyJraWQiOiJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: your own address, if /me auto-detection picks the wrong one.
# SELF_EMAIL=you@example.com
